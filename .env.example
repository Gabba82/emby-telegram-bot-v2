# EMBY-005 — plantilla de entorno
#
# COPIA este archivo a `.env` y rellena los valores reales. El archivo `.env`
# esta excluido por .gitignore y .dockerignore: las credenciales nunca entran en
# la imagen ni en el repositorio.
#
#   cp .env.example .env
#
# La aplicacion NO arranca sin TELEGRAM_TOKEN, EMBY_API_KEY y CHAT_IDS.

# --------------------------------------------------------------------------- #
# Obligatorios (produccion)
# --------------------------------------------------------------------------- #
# Token del bot creado con @BotFather.
TELEGRAM_TOKEN=replace_me

# Clave de API de Emby (Administrador -> Claves de API).
EMBY_API_KEY=replace_me

# Destinos de publicacion, separados por comas (supergrupos con -100...).
CHAT_IDS=-1000000000000

# --------------------------------------------------------------------------- #
# Destinos opcionales
# --------------------------------------------------------------------------- #
# Chats con privilegio de administracion (comandos manuales del bot).
ADMIN_CHAT_IDS=
# Chats que reciben avisos de biblioteca y reproduccion (si vacio, se usan CHAT_IDS).
LIBRARY_CHAT_IDS=
PLAYBACK_CHAT_IDS=
# Etiquetas legibles por chat, formato id:Etiqueta.
CHAT_LABELS=

# --------------------------------------------------------------------------- #
# Conectividad con Emby
# --------------------------------------------------------------------------- #
EMBY_API_URL=http://emby:8096/emby

# --------------------------------------------------------------------------- #
# Comportamiento
# --------------------------------------------------------------------------- #
REQUEST_TIMEOUT_SECONDS=15
EPISODE_BUFFER_SECONDS=60
LIBRARY_DEBOUNCE_SECONDS=120
PLAYBACK_DEBOUNCE_SECONDS=10
ENABLE_LIBRARY_NOTIFICATIONS=true
ENABLE_PLAYBACK_NOTIFICATIONS=true
PLAYBACK_NOTIFY_PAUSE=false
PLAYBACK_WITH_IMAGE=false
PLAYBACK_STYLE=compact
APP_TIMEZONE=Europe/Madrid

# Secreto del webhook de TELEGRAM (/telegramhook), no de Emby.
# Si se define, Telegram debe enviarlo en la cabecera X-Telegram-Bot-Api-Secret-Token;
# si se deja vacio, el webhook de Telegram no lo exige.
#
# OJO: el webhook de EMBY (/embyhook) NO usa esta variable. Su proteccion depende de
# la red y del proxy: restringe quien puede alcanzar el puerto 8081 (o el proxy) y, si
# tu proxy lo permite, exige una cabecera/token propio configurado ahi.
TELEGRAM_WEBHOOK_SECRET=

# --------------------------------------------------------------------------- #
# Persistencia
# --------------------------------------------------------------------------- #
# Ledger SQLite. Dentro del contenedor debe ser /data/history.sqlite3.
# Es un fichero persistente, NO una base en memoria.
HISTORY_DB_PATH=/data/history.sqlite3

# --------------------------------------------------------------------------- #
# Panel de publicacion y conciliacion (OPCIONAL, desactivado por defecto)
# --------------------------------------------------------------------------- #
# false = el panel no existe. true = requiere las tres variables de abajo.
PANEL_ENABLED=false

# Solo si PANEL_ENABLED=true. Minimo 16 caracteres y no un valor de demo.
# Genera uno con:  python -c "import secrets;print(secrets.token_urlsafe(24))"
PANEL_ADMIN_PASSWORD=

# Solo si PANEL_ENABLED=true. Minimo 32 caracteres, distinto de la contrasena.
# Genera uno con:  python -c "import secrets;print(secrets.token_hex(32))"
PANEL_SECRET_KEY=

# Solo afecta a los envios manuales desde el panel. Los webhooks del bot
# siguen activos aunque esto sea false.
PANEL_ALLOW_SENDS=false

# --------------------------------------------------------------------------- #
# Despliegue
# --------------------------------------------------------------------------- #
# Publicación local por defecto; el contenedor escucha en 8081.
# /embyhook no tiene autenticación propia: protege su acceso en red/proxy.
# Para acceso directo desde Emby remoto, fija explícitamente la IP de una interfaz
# de confianza y aplica firewall/VPN. Un proxy en otro contenedor no alcanza este
# loopback del host: usa una red Docker compartida o una IP de confianza explícita.
APP_BIND=127.0.0.1
APP_PORT=8081
